# Copy to .env.local and fill in real values. Nothing here is a confirmed
# secret — these are placeholders describing what the contact form and
# metadata will need once real services are connected (Phase 4+).

# Production site URL, used for metadata, sitemap and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://www.hashtechsolutions.example

# Spam protection for the contact form (e.g. Google reCAPTCHA v3).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Transactional email provider used to deliver contact-form enquiries
# (e.g. Resend, SendGrid). CONTACT_EMAIL_TO defaults to the address in
# src/data/company.ts if left blank.
CONTACT_EMAIL_API_KEY=
CONTACT_EMAIL_TO=
